{
  "name": "gctools",
  "version": "0.1.0",
  "description": "Command line utilities for working with Ghost content",
  "repository": "https://github.com/TryGhost/gctools",
  "author": "Ghost Foundation",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.13.0"
  },
  "license": "MIT",
  "bin": {
    "gctools": "./bin/cli.js"
  },
  "scripts": {
    "dev": "node bin/cli.js",
    "gctools": "gctools",
    "test:file": "node --test --experimental-test-module-mocks",
    "test": "node --test --experimental-test-module-mocks test/*.test.js",
    "test:coverage": "node --test --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=47 --test-coverage-branches=87 --test-coverage-functions=43 test/*.test.js",
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "update": "git pull origin main && pnpm install"
  },
  "dependencies": {
    "@inquirer/confirm": "6.3.5",
    "@tryghost/admin-api": "1.14.14",
    "@tryghost/errors": "3.4.4",
    "@tryghost/listr-smart-renderer": "0.15.7",
    "@tryghost/mg-assetscraper-db": "0.13.7",
    "@tryghost/mg-fs-utils": "0.26.7",
    "@tryghost/mg-ghost-authors": "0.10.7",
    "@tryghost/pretty-cli": "3.4.0",
    "@tryghost/string": "0.3.8",
    "@tryghost/zip": "3.5.18",
    "axios": "1.20.0",
    "bluebird": "3.7.2",
    "chalk": "6.0.1",
    "cli-progress": "3.12.0",
    "file-type": "22.2.0",
    "fs-extra": "11.4.1",
    "glob": "13.0.6",
    "heic-convert": "2.1.0",
    "inquirer": "14.2.4",
    "inquirer-datepicker-prompt": "0.4.3",
    "inquirer-search-checkbox": "1.0.0",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "lorem-ipsum": "3.0.0",
    "superbytes": "2.1.0",
    "title-case": "4.3.2",
    "tty-table": "7.2.1"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0"
  }
}
