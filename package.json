{
  "name": "gctools",
  "version": "0.1.0",
  "description": "Command line utilities for working with Ghost content",
  "repository": "https://github.com/TryGhost/gctools",
  "author": "Ghost Foundation",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.13.0"
  },
  "license": "MIT",
  "bin": {
    "gctools": "./bin/cli.js"
  },
  "scripts": {
    "dev": "node bin/cli.js",
    "gctools": "gctools",
    "test:file": "node --test --experimental-test-module-mocks",
    "test": "node --test --experimental-test-module-mocks test/*.test.js",
    "test:coverage": "node --test --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=47 --test-coverage-branches=87 --test-coverage-functions=43 test/*.test.js",
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "update": "git pull origin main && pnpm install"
  },
  "dependencies": {
    "@inquirer/confirm": "6.4.1",
    "@tryghost/admin-api": "1.14.16",
    "@tryghost/errors": "3.4.8",
    "@tryghost/listr-smart-renderer": "0.16.6",
    "@tryghost/mg-assetscraper-db": "0.14.6",
    "@tryghost/mg-fs-utils": "0.27.6",
    "@tryghost/mg-ghost-authors": "0.11.6",
    "@tryghost/pretty-cli": "3.4.4",
    "@tryghost/string": "0.3.10",
    "@tryghost/zip": "4.1.0",
    "axios": "1.21.1",
    "bluebird": "3.7.2",
    "chalk": "6.0.1",
    "cli-progress": "3.12.0",
    "file-type": "22.3.0",
    "fs-extra": "11.4.1",
    "glob": "14.0.6",
    "heic-convert": "2.1.0",
    "inquirer": "14.3.0",
    "inquirer-datepicker-prompt": "0.4.3",
    "inquirer-search-checkbox": "1.0.0",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "lorem-ipsum": "3.0.0",
    "superbytes": "2.1.0",
    "title-case": "4.3.2",
    "tty-table": "7.2.2"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "devDependencies": {
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0"
  }
}
