{
  "name": "gctools",
  "version": "0.1.0",
  "description": "Command line utilities for working with Ghost content",
  "repository": "https://github.com/TryGhost/gctools",
  "author": "Ghost Foundation",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.13.0"
  },
  "license": "MIT",
  "bin": {
    "gctools": "./bin/cli.js"
  },
  "scripts": {
    "dev": "node bin/cli.js",
    "gctools": "gctools",
    "test:file": "node --test --experimental-test-module-mocks",
    "test": "node --test --experimental-test-module-mocks test/*.test.js",
    "test:coverage": "node --test --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=47 --test-coverage-branches=87 --test-coverage-functions=43 test/*.test.js",
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "update": "git pull origin main && pnpm install"
  },
  "dependencies": {
    "@inquirer/confirm": "6.3.5",
    "@tryghost/admin-api": "1.14.14",
    "@tryghost/errors": "3.4.7",
    "@tryghost/listr-smart-renderer": "0.16.0-0",
    "@tryghost/mg-assetscraper-db": "0.14.0-0",
    "@tryghost/mg-fs-utils": "0.27.0-0",
    "@tryghost/mg-ghost-authors": "0.11.0-0",
    "@tryghost/pretty-cli": "3.4.3",
    "@tryghost/string": "0.3.8",
    "@tryghost/zip": "4.0.2",
    "axios": "1.21.0",
    "bluebird": "3.7.2",
    "chalk": "6.0.1",
    "cli-progress": "3.12.0",
    "file-type": "22.3.0",
    "fs-extra": "11.4.1",
    "glob": "14.0.4",
    "heic-convert": "2.1.0",
    "inquirer": "14.2.5",
    "inquirer-datepicker-prompt": "0.4.3",
    "inquirer-search-checkbox": "1.0.0",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "lorem-ipsum": "3.0.0",
    "superbytes": "2.1.0",
    "title-case": "4.3.2",
    "tty-table": "7.2.1"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "devDependencies": {
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0"
  }
}
